# ============================================================
# Raksha AI & Location-Logic Engine — Environment Config
# Copy this file to .env and fill in your values.
# ============================================================

PROJECT_NAME="Raksha Citizen Safety Engine"
DEBUG=False

# ============================================================
# LLM PROVIDER — choose ONE block below and fill it in
# ============================================================

# ── OPTION 1: GROQ (recommended for hackathon) ─────────────
# Free API key → https://console.groq.com/keys  (sign-in with Google)
# Supports: llama-3.1-8b-instant | llama-3.3-70b-versatile | mixtral-8x7b-32768 | gemma2-9b-it
LLM_PROVIDER=groq
LLM_API_KEY=gsk_YOUR_GROQ_KEY_HERE
LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=10.0

# ── OPTION 2: OLLAMA (fully local, no key, no internet) ────
# 1. Install: https://ollama.com/download
# 2. Pull model: ollama pull llama3.2
# 3. Start:      ollama serve
# LLM_PROVIDER=ollama
# LLM_API_KEY=
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434
# LLM_TIMEOUT_SECONDS=30.0

# ── OPTION 3: GOOGLE GEMINI ────────────────────────────────
# Get key: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIza_YOUR_GEMINI_KEY_HERE
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=
# LLM_TIMEOUT_SECONDS=10.0

# ── OPTION 4: OPENAI ───────────────────────────────────────
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-YOUR_OPENAI_KEY_HERE
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=
# LLM_TIMEOUT_SECONDS=10.0

# ── OPTION 5: OFFLINE MOCK (no key needed, demo/test) ──────
# LLM_PROVIDER=mock
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_TIMEOUT_SECONDS=5.0

# ============================================================
# Location & Radius Escalation Thresholds (MVP Rule)
# ============================================================
LLM_MAX_RETRIES=1
INITIAL_SEARCH_RADIUS_METERS=300
EXPANDED_SEARCH_RADIUS_METERS=500
RADIUS_EXPANSION_THRESHOLD_SECONDS=30

# Candidate Duplicate Detection
DUPLICATE_DISTANCE_THRESHOLD_METERS=200.0
DUPLICATE_TIME_WINDOW_SECONDS=1800
DUPLICATE_TEXT_SIMILARITY_THRESHOLD=0.45
